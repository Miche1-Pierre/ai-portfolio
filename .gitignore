# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.claude/
.mcp.json

# blender workspace (see blender/CLAUDE.md)
/blender/renders/*
!/blender/renders/.gitkeep
/blender/exports/_smoke*
*.blend1
*.blend2
*.blend@
__pycache__/

# third-party reference images and example models: copyrighted, public repo -> local only
# (blender/references/README.md + INDEX.md stay versioned)
/blender/references/**/*.jpg
/blender/references/**/*.jpeg
/blender/references/**/*.png
/blender/references/**/*.webp
/blender/references/models/**
!/blender/references/models/.gitkeep
